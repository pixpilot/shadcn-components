                {
                  "id": "pickUp",
                  "name": "keyboard.press",
                  "args": { "key": "Space" }
                },
                {
                  "id": "moveRight",
                  "name": "keyboard.press",
                  "args": { "key": "ArrowRight" }
                },
                {
                  "id": "dropCard",
