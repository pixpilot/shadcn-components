      "screenshots": [
        {
          "id": "kbMove01",
          "index": 0,
          "title": "Custom cards after a keyboard drag",
          "browserType": "chromium",
          "browserOptionsId": "kanbanDesktop",
          "actionSets": [
            {
              "id": "moveCard",
              "title": "Move a card to the next column",
              "actions": [
                {
                  "id": "focusCard",
                  "name": "focus",
                  "args": { "selector": "[data-testid=\"kanban-item-1\"]" }
