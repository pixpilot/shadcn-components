                  "args": { "key": "Space" }
                },
                {
                  "id": "captureMovedBoard",
                  "name": "takeElementScreenshot",
                  "args": { "selector": "[data-testid=\"kanban-board\"]" }
                }
              ]
            }
          ]
        }
      ]
    },
    "shadcn-kanban-kanbanboard--infinite-scroll-columns": {
      "screenshots": [
        {
          "id": "kbInfinite01",
          "index": 0,
          "title": "Second page loaded after scrolling a column to its end",
          "browserType": "chromium",
          "browserOptionsId": "kanbanDesktop",
          "actionSets": [
            {
              "id": "loadNextPage",
              "title": "Scroll the To Do column until the sentinel loads page two",
              "actions": [
                {
                  "id": "scrollTodoColumn",
