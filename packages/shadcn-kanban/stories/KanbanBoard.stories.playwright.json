                  "args": {
                    "selector": "[data-testid=\"kanban-column-scroller-todo\"]",
                    "scrollProperty": { "top": 4000 }
                  }
                },
                {
                  "id": "awaitSecondPage",
                  "name": "waitForSelector",
                  "args": {
                    "selector": "[data-testid=\"kanban-item-todo-26\"]",
                    "state": "visible"
                  }
                },
                {
                  "id": "captureLoadedBoard",
                  "name": "takeElementScreenshot",
                  "args": { "selector": "[data-testid=\"kanban-board\"]" }
                }
              ]
            }
          ]
        }
      ]
    },
